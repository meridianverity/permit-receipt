{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentAction",
  "type": "object",
  "required": ["type", "version", "tenant_id", "agent_id", "purpose_id", "merchant", "cart", "totals", "payment", "context"],
  "properties": {
    "type": {"const": "PaymentAction"},
    "version": {"type": "string"},
    "tenant_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "purpose_id": {"type": "string"},
    "merchant": {
      "type": "object",
      "required": ["merchant_id", "display_name"],
      "properties": {
        "merchant_id": {"type": "string"},
        "display_name": {"type": "string"}
      }
    },
    "cart": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "name", "quantity", "unit_price_minor", "line_total_minor"],
        "properties": {
          "sku": {"type": "string"},
          "name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price_minor": {"type": "integer", "minimum": 0},
          "line_total_minor": {"type": "integer", "minimum": 0}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["currency", "subtotal_minor", "tax_minor", "shipping_minor", "discount_minor", "total_minor"],
      "properties": {
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "subtotal_minor": {"type": "integer"},
        "tax_minor": {"type": "integer"},
        "shipping_minor": {"type": "integer"},
        "discount_minor": {"type": "integer"},
        "total_minor": {"type": "integer"}
      }
    },
    "payment": {
      "type": "object",
      "required": ["capture_mode", "idempotency_key", "instrument_ref"],
      "properties": {
        "capture_mode": {"type": "string"},
        "idempotency_key": {"type": "string"},
        "instrument_ref": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "required": ["sensor_receipt_core_digest", "agent_plan_digest", "commerce_session_id"],
      "properties": {
        "sensor_receipt_core_digest": {"type": "string", "pattern": "^sha256:"},
        "agent_plan_digest": {"type": "string", "pattern": "^sha256:"},
        "commerce_session_id": {"type": "string"}
      }
    }
  }
}
