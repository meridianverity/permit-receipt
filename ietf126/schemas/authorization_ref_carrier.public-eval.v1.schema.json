{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridianverity.com/schemas/orprg/authorization_ref_carrier.public-eval.v1.schema.json",
  "title": "ORPRG public-evaluation signed authorization_ref carrier v1",
  "description": "Ed25519-authenticated envelope proving coverage of the selected authorization_ref object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["carrier", "authenticity"],
  "properties": {
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier_profile", "authorization_ref"],
      "properties": {
        "carrier_profile": {
          "const": "PermitReceipt.authorization-ref.carrier.public-eval.v1"
        },
        "authorization_ref": {
          "$ref": "authorization_ref.public-eval.v2.schema.json"
        }
      }
    },
    "authenticity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "signature_algorithm", "signature"],
      "properties": {
        "issuer_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "signature_algorithm": {"const": "ed25519"},
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
