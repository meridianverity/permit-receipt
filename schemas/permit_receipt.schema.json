{
  "$defs": {
    "boundedIdentifier": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "hex64": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rfc3339Profile": {
      "maxLength": 40,
      "pattern": "^(?!.*-00:00$)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "action_type": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "effect_type": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "interface_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "key_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "key_op": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "key_ops": {
          "items": {
            "$ref": "#/$defs/boundedIdentifier"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "max_effect_budget": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "purpose_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "representation_class_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "target_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/boundedIdentifier"
        }
      },
      "type": "object"
    },
    "jsonSafeObject": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "maxLength": 65536
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonSafeValue"
      }
    },
    "jsonSafeValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/jsonSafeValue"
          }
        },
        {
          "$ref": "#/$defs/jsonSafeObject"
        }
      ]
    }
  },
  "$id": "https://meridianverity.example/schemas/permit-receipt/public-eval/v2.2.6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict synthetic PermitReceipt envelope used by the v2.2.6 public-evaluation artifact.",
  "properties": {
    "authenticity": {
      "additionalProperties": false,
      "properties": {
        "issuer_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "signature": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "issuer_id",
        "signature"
      ],
      "type": "object"
    },
    "receipt_core": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "$ref": "#/$defs/hex64"
        },
        "anti_replay": {
          "additionalProperties": false,
          "properties": {
            "nonce": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "nonce"
          ],
          "type": "object"
        },
        "assurance_evidence_digest": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "assurance_level_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "authority_profile_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "epoch_id": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "identity_binding": {
          "$ref": "#/$defs/jsonSafeObject"
        },
        "issuer_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "jurisdiction": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "permit_provenance_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "policy_digest": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "purpose_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "tenant_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "transparency_anchor_digest": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "valid_from": {
          "$ref": "#/$defs/rfc3339Profile"
        },
        "valid_to": {
          "$ref": "#/$defs/rfc3339Profile"
        }
      },
      "required": [
        "policy_digest",
        "epoch_id",
        "valid_from",
        "valid_to",
        "action_digest",
        "scope",
        "anti_replay",
        "canonicalization_profile_ref",
        "authority_profile_id",
        "assurance_level_id",
        "issuer_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "receipt_core",
    "authenticity"
  ],
  "title": "PermitReceipt Public-Evaluation Profile v2.2.6",
  "type": "object"
}
