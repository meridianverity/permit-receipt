{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridianverity.example/schemas/capability-token/public-eval/v2.2.6",
  "title": "PermitReceipt Capability Token Public-Evaluation Profile v2.2.6",
  "type": "object",
  "required": [
    "token_core",
    "authenticity"
  ],
  "additionalProperties": false,
  "$defs": {
    "boundedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339Profile": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?!.*-00:00$)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "properties": {
    "token_core": {
      "type": "object",
      "required": [
        "action_digest",
        "receipt_digest",
        "policy_digest",
        "epoch_id",
        "audience",
        "tenant_id",
        "valid_to",
        "nonce"
      ],
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "$ref": "#/$defs/hex64"
        },
        "receipt_digest": {
          "$ref": "#/$defs/hex64"
        },
        "policy_digest": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "epoch_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "audience": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "valid_to": {
          "$ref": "#/$defs/rfc3339Profile"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "authenticity": {
      "type": "object",
      "required": [
        "issuer_id",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "issuer_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
