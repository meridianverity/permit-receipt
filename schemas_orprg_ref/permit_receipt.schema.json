{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAYGATE-Ref PermitReceipt",
  "type": "object",
  "required": ["receipt_core", "authenticity"],
  "properties": {
    "receipt_core": {
      "type": "object",
      "required": ["policy_digest", "epoch_id", "valid_from", "valid_to", "action_digest", "scope", "anti_replay", "canonicalization_profile_ref", "issuer_id"],
      "properties": {
        "policy_digest": {"type": "string"},
        "epoch_id": {"type": ["integer", "string"]},
        "valid_from": {"type": "string"},
        "valid_to": {"type": "string"},
        "action_digest": {"type": "string"},
        "canonicalization_profile_ref": {"type": "string"},
        "scope": {"type": "object"},
        "anti_replay": {"type": "object"},
        "authority_profile_id": {"type": "string"},
        "assurance_level_id": {"type": "string"},
        "permit_provenance_digest": {"type": "string"},
        "issuer_id": {"type": "string"}
      }
    },
    "authenticity": {
      "type": "object",
      "required": ["issuer_id", "signature"],
      "properties": {
        "issuer_id": {"type": "string"},
        "signature": {"type": "string"},
        "issuer_chain": {"type": ["array", "string", "null"]},
        "threshold_signature": {"type": ["object", "string", "null"]}
      }
    }
  }
}
